{
  "name": "formula-one",
  "version": "1.0.0",
  "description": "Minimal API da Formula 1 com Node.js, TypeScript e Fastify.",
  "main": "dist/server.js",
  "scripts": {
    "dist": "tsup src/server.ts --format cjs --clean",
    "start:dev": "tsx --env-file=.env src/server.ts",
    "start:watch": "tsx watch --env-file=.env src/server.ts",
    "start:dist": "npm run dist && node dist/server.js",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "fastify",
    "rest-api",
    "formula-1",
    "minimal-api"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsup": "^8.0.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/swagger": "^9.9.3",
    "fastify": "^5.12.8"
  }
}
